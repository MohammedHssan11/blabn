# Public Supabase settings (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only settings. Never expose or commit production values.
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the application, used in password-recovery links and to decide whether session
# cookies are marked Secure (https:// sites). No trailing slash. Local default: http://127.0.0.1:3000
SITE_URL=
