{
  "name": "balaban-branch-operations",
  "version": "0.2.0",
  "private": true,
  "description": "Balaban branch operations - Arabic and English web application",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/phase2/smoke.mjs",
    "seed:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/phase2/build-seed.mjs",
    "seed:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/phase2/build-seed.mjs --check",
    "db:check": "node scripts/phase2/db-check.mjs",
    "fieldmap:check": "python -I -X utf8 scripts/phase1/build_field_map.py --check",
    "check": "npm run typecheck && npm run test && npm run build",
    "db:check:phase3": "node scripts/phase3/db-check.mjs phase3_checks.sql",
    "db:upgrade-test": "node scripts/phase3/upgrade-test.mjs",
    "test:phase3": "node scripts/phase3/e2e.mjs",
    "test:browser": "node scripts/phase3/browser-check.mjs",
    "test:concurrency": "node scripts/phase3/concurrency-test.mjs",
    "db:check:phase4": "node scripts/phase3/db-check.mjs phase4_checks.sql",
    "test:phase4": "node scripts/phase4/browser-check.mjs",
    "seed:catalog": "node scripts/phase5/build-catalog-seed.mjs",
    "seed:catalog:check": "node scripts/phase5/build-catalog-seed.mjs --check",
    "catalog:extract": "python -I -X utf8 scripts/phase5/extract_catalog.py",
    "db:check:phase5": "node scripts/phase3/db-check.mjs phase5_checks.sql",
    "db:check:phase6": "node scripts/phase3/db-check.mjs phase6_checks.sql",
    "db:check:phase7": "node scripts/phase3/db-check.mjs phase7_checks.sql",
    "db:check:phase8": "node scripts/phase3/db-check.mjs phase8_checks.sql",
    "test:phase5": "node scripts/phase5/e2e.mjs",
    "test:phase5:browser": "node scripts/phase5/browser-check.mjs",
    "test:phase6": "node scripts/phase6/e2e.mjs",
    "test:phase6:browser": "node scripts/phase6/browser-check.mjs",
    "test:phase7": "node scripts/phase7/e2e.mjs",
    "test:phase7:browser": "node scripts/phase7/browser-check.mjs",
    "test:phase8": "node scripts/phase8/e2e.mjs",
    "test:phase8:browser": "node scripts/phase8/browser-check.mjs",
    "db:check:phase9": "node scripts/phase3/db-check.mjs phase9_checks.sql",
    "test:phase9": "node scripts/phase9/e2e.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.65.1",
    "supabase": "2.122.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
